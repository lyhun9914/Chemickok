{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import headroom' >/dev/null 2>&1 || pip install -q \"headroom-ai==0.44.0\" >/dev/null 2>&1; exit 0",
            "timeout": 150
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 || pip install -q \"graphifyy[sql]\" >/dev/null 2>&1 || python3 -m pip install -q \"graphifyy[sql]\" >/dev/null 2>&1; command -v typescript-language-server >/dev/null 2>&1 || npm install -g --silent typescript-language-server typescript >/dev/null 2>&1; command -v agent-browser >/dev/null 2>&1 || npm install -g --silent agent-browser@0.43.0 >/dev/null 2>&1; command -v gsd-sdk >/dev/null 2>&1 || npm install -g --silent get-shit-done-cc@1.42.3 >/dev/null 2>&1; cd \"$CLAUDE_PROJECT_DIR\" && [ ! -f graphify-out/graph.json ] && command -v graphify >/dev/null 2>&1 && graphify update . >/dev/null 2>&1; exit 0",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' '[GSD] 대화가 요약됐거나 다시 시작됐다. 아래 진행 상태(.planning/STATE.md)의 할 일부터 이어 간다. .planning/.continue-here.md 가 있으면 그것도 읽는다(/gsd:resume-work).'; sed -n '1,60p' \"$CLAUDE_PROJECT_DIR/.planning/STATE.md\" 2>/dev/null; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/headroom-hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "task-observer@one-skill-to-rule-them-all": true,
    "ponytail@ponytail": true,
    "agent-browser@agent-browser": true,
    "taste-skill@taste-skill": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "supabase@supabase-agent-skills": true,
    "postgres-best-practices@supabase-agent-skills": true,
    "marketing@knowledge-work-plugins": true,
    "customer-support@knowledge-work-plugins": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "one-skill-to-rule-them-all": {
      "source": {
        "source": "github",
        "repo": "rebelytics/one-skill-to-rule-them-all"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "agent-browser": {
      "source": {
        "source": "github",
        "repo": "vercel-labs/agent-browser"
      }
    },
    "taste-skill": {
      "source": {
        "source": "github",
        "repo": "Leonxlnx/taste-skill"
      }
    },
    "supabase-agent-skills": {
      "source": {
        "source": "github",
        "repo": "supabase/agent-skills"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  }
}
