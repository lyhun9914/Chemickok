# ── AI (server only) ──────────────────────────────
# Leave empty to run with the built-in sample (mock) report.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low        # low | medium | high  (higher = richer text, slower)

# ── Database (server only) ────────────────────────
# Supabase project "Chemickok-Seoul" (ap-northeast-2, Seoul)
SUPABASE_URL=https://oztvxpizxzbwzhvdswqq.supabase.co
# Dashboard → Project Settings → API Keys → Secret key (sb_secret_...). Never expose to the browser.
SUPABASE_SECRET_KEY=

# ── Payments ──────────────────────────────────────
# Client flag: true = payment modal bypasses the PG and unlocks instantly.
NEXT_PUBLIC_PAYMENT_TEST_MODE=true
# Server gate: must be "false" in production so test unlocks are rejected.
PAYMENT_TEST_MODE=true
# Toss Payments keys (https://developers.tosspayments.com) — needed only when test mode is off.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── Sharing ───────────────────────────────────────
# Kakao JavaScript key (https://developers.kakao.com). Empty = falls back to Web Share / copy link.
NEXT_PUBLIC_KAKAO_JS_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
