# ── Payments ──────────────────────────────────────
# Client flag: true = payment modal bypasses the PG and unlocks instantly.
NEXT_PUBLIC_PAYMENT_TEST_MODE=true
# Server gate: must be "false" in production so test unlocks are rejected.
PAYMENT_TEST_MODE=true
# Toss Payments keys (https://developers.tosspayments.com) — needed only when test mode is off.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 냥 (복채 엽전) ────────────────────────────────
# 충전 상품 · 점괘별 냥 · 가입/초대 선물은 src/lib/config.ts (COIN_PACKS, coins, WELCOME_COINS, INVITE_COINS)에서 바꿉니다.
# 결제창: 토스페이 · 카카오페이는 각 앱이 바로 열리고, "카드·기타"는 토스페이먼츠 통합 결제창이 열립니다.

# ── Sharing ───────────────────────────────────────
# Kakao JavaScript key (https://developers.kakao.com). Empty = falls back to Web Share / copy link.
NEXT_PUBLIC_KAKAO_JS_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 회원 (로그인 · 내 점괘함) ─────────────────────
# All empty = no login buttons; the app works exactly as before (nothing is stored).
# Session signing key — any random string of 32+ characters (e.g. `openssl rand -base64 32`).
AUTH_SECRET=
# Supabase project (Project Settings → API): URL and the *secret* key (server only, never NEXT_PUBLIC).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Kakao Developers → 앱 키 → REST API 키 (+ 보안 → Client Secret, if enabled). Redirect URI: {site}/api/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Naver Developers → 애플리케이션. Callback URL: {site}/api/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Google Cloud Console → 사용자 인증 정보 → OAuth 클라이언트 ID (웹). Redirect URI: {site}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 이메일 회원가입은 위 Supabase + AUTH_SECRET만 있으면 켜집니다 (별도 키 없음).
# 비밀번호 재설정 메일 (선택). Gmail: SMTP_USER=주소, SMTP_PASS=앱 비밀번호 (Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호).
# 다른 메일 서비스는 SMTP_HOST / SMTP_PORT도 넣습니다. 비워 두면 "비밀번호 찾기"는 고객문의로 안내합니다.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
# Local testing only: "1" adds a 🧪 test login and an in-memory DB when Supabase isn't set. Ignored on Vercel production.
AUTH_DEV_LOGIN=
